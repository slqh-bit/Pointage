# ── Base de données (CCTP : SQL Server 2019+ ou MySQL 5.7+ → MySQL 8 via Prisma)
DATABASE_URL="mysql://pointage:pointage@localhost:3306/pointage_rabta"

# ── HTTP
PORT=8080
HOST=0.0.0.0
# Origine du portail derrière IIS (443)
CORS_ORIGIN="https://pointage.chu-rabta.local"

# ── JWT (jose) — générer un secret ≥ 32 octets en production
JWT_SECRET="change-me-32-bytes-minimum-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Sécurité (clause sécurité : complexité, renouvellement, verrouillage)
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_AGE_DAYS=90
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# ── Pont .NET 4.8 (gabarits biométriques uniquement — si le spike P0 l'exige)
TEMPLATE_BRIDGE_URL=""

# ── Email (alertes terminaux hors ligne, notifications)
SMTP_URL="smtp://localhost:25"
MAIL_FROM="pointage@chu-rabta.local"
