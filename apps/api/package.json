{
  "name": "@pointage/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Fastify + Prisma — services cœur du système de pointage (Plan §03/§09).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/type-provider-typebox": "^4.0.0",
    "@node-rs/argon2": "^1.8.3",
    "@pointage/contracts": "workspace:*",
    "@pointage/drivers": "workspace:*",
    "@prisma/client": "^5.20.0",
    "@sinclair/typebox": "^0.32.35",
    "csv-stringify": "^6.5.1",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "jose": "^5.9.3",
    "pdfmake": "^0.2.12",
    "prisma": "^5.20.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pdfmake": "^0.2.9",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
