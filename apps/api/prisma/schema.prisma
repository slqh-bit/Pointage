// ─────────────────────────────────────────────────────────────────────────────
// Système de pointage biométrique — CHU La Rabta (INF01/2026)
// Schéma de données — Plan de développement §07 (22 tables, 8 groupes)
//
// Règles structurantes (§06 / §07) :
//   · punch est append-only, jamais muté. Toute correction = nouvelle ligne
//     dans punch_correction avec lien vers l'original et auteur.
//   · Idempotence terminaux : unique (deviceId, deviceUserId, punchedAt).
//   · day_result : une ligne par agent par jour, recalcul incrémental,
//     reconstruisable intégralement depuis les données brutes.
//   · absence_day est la forme éclatée par jour — c'est contre elle que le
//     moteur de règles joint, pas contre la plage de la demande.
//   · user_scope rend le RBAC réel : Gestionnaire → services, Superviseur → équipe.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════ ORGANISATION ════════════════════════════════

/// Un site = un bloc du CHU (25 blocs au périmètre).
model Site {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(20)
  nameFr    String   @db.VarChar(120)
  nameAr    String?  @db.VarChar(120)
  address   String?  @db.VarChar(255)
  lat       Decimal? @db.Decimal(10, 7)
  lng       Decimal? @db.Decimal(10, 7)
  /// Rayon du géorepérage mobile (mètres) — P6.
  geofenceRadiusM Int    @default(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       Service[]
  devices        Device[]
  scheduleEntries ScheduleEntry[]

  @@map("site")
}

/// Un service rattaché à un bloc (35+ services).
model Service {
  id        String   @id @default(cuid())
  siteId    String
  code      String   @db.VarChar(20)
  nameFr    String   @db.VarChar(120)
  nameAr    String?  @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site      Site      @relation(fields: [siteId], references: [id])
  employees Employee[]
  devices   Device[]
  schedules ScheduleEntry[]
  userScopes UserScope[]

  @@unique([siteId, code])
  @@index([siteId])
  @@map("service")
}

/// Catégorie d'agent — détermine le jeu de règles applicable
/// (médical, paramédical, administratif, ouvrier).
model EmployeeCategory {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(30)
  nameFr      String   @db.VarChar(120)
  nameAr      String?  @db.VarChar(120)
  /// Jeu de règles appliqué par le moteur (clé de configuration).
  ruleSetKey  String   @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("employee_category")
}

/// Agent du CHU (3 000+). Le matricule RH est la clé métier.
model Employee {
  id          String   @id @default(cuid())
  matricule   String   @unique @db.VarChar(20)
  firstName   String   @db.VarChar(80)
  lastName    String   @db.VarChar(80)
  serviceId   String
  categoryId  String
  email       String?  @db.VarChar(190)
  phone       String?  @db.VarChar(30)
  hiredAt     DateTime? @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service          Service            @relation(fields: [serviceId], references: [id])
  category         EmployeeCategory   @relation(fields: [categoryId], references: [id])
  user             User?
  credentials      Credential[]
  enrollments      DeviceEnrollment[]
  punches          Punch[]
  scheduleEntries  ScheduleEntry[]
  absenceRequests  AbsenceRequest[]
  absenceDays      AbsenceDay[]
  leaveBalances    LeaveBalance[]
  dayResults       DayResult[]
  overtimeRequests OvertimeRequest[]
  anomalies        Anomaly[]

  @@index([serviceId])
  @@index([categoryId])
  @@map("employee")
}

// ═══════════════════════════════ TERMINAUX ══════════════════════════════════

/// Pointeuse biométrique (25 en exploitation). Multi-marques via `brand`
/// et le contrat DeviceDriver (packages/drivers).
model Device {
  id           String   @id @default(cuid())
  siteId       String
  serviceId    String?
  brand        DeviceBrand
  model        String?  @db.VarChar(60)
  serialNumber String?  @unique @db.VarChar(60)
  ipAddress    String?  @db.VarChar(45)
  firmware     String?  @db.VarChar(40)
  /// ADMS_PUSH (mode A, primaire) ou PULL (mode B, réconciliation).
  captureMode  CaptureMode @default(ADMS_PUSH)
  isActive     Boolean  @default(true)
  lastSeenAt   DateTime?
  storageFreeKb Int?
  tamperState  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site         Site    @relation(fields: [siteId], references: [id])
  service      Service? @relation(fields: [serviceId], references: [id])
  enrollments  DeviceEnrollment[]
  punches      Punch[]
  commands     DeviceCommand[]

  @@index([siteId])
  @@map("device")
}

enum DeviceBrand {
  ZKTECO
  SUPREMA
  HIKVISION
}

enum CaptureMode {
  ADMS_PUSH
  PULL
}

/// Quel agent est enrôlé sur quel terminal, avec quel identifiant terminal.
model DeviceEnrollment {
  id           String   @id @default(cuid())
  deviceId     String
  employeeId   String
  /// Identifiant de l'agent côté terminal (pin / user id du firmware).
  deviceUserId String   @db.VarChar(40)
  enrolledAt   DateTime @default(now())
  enrolledById String?
  isActive     Boolean  @default(true)

  device   Device   @relation(fields: [deviceId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([deviceId, deviceUserId])
  @@unique([deviceId, employeeId])
  @@map("device_enrollment")
}

/// Un credential par agent : gabarit biométrique (jamais d'image brute —
/// loi organique 63/2004), badge RFID, ou PIN.
model Credential {
  id          String         @id @default(cuid())
  employeeId  String
  kind        CredentialKind
  /// Référence opaque du gabarit (non réversible par construction).
  templateRef String?        @db.VarChar(190)
  badgeNumber String?        @db.VarChar(40)
  isActive    Boolean        @default(true)
  issuedAt    DateTime       @default(now())
  revokedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("credential")
}

enum CredentialKind {
  FACE_TEMPLATE
  FINGERPRINT_TEMPLATE
  BADGE
  PIN
}

/// File sortante consommée par l'ack ADMS : listes d'utilisateurs,
/// commandes de porte, synchronisation d'horloge.
model DeviceCommand {
  id          String        @id @default(cuid())
  deviceId    String
  kind        String        @db.VarChar(40)
  payload     Json?
  status      CommandStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  deliveredAt DateTime?
  ackedAt     DateTime?

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, status])
  @@map("device_command")
}

enum CommandStatus {
  PENDING
  DELIVERED
  ACKED
  FAILED
}

// ═══════════════════════════ CAPTURE BRUTE ══════════════════════════════════

/// Pointage brut, append-only. Jamais muté (§06 — DESIGN RULE).
/// Idempotence : un retry ADMS ne crée jamais de doublon.
model Punch {
  id           String      @id @default(cuid())
  employeeId   String?
  deviceId     String?
  deviceUserId String?     @db.VarChar(40)
  punchedAt    DateTime
  source       PunchSource
  verifyMode   VerifyMode?
  /// Coordonnées GPS quand source = MOBILE (§09, P6).
  lat          Decimal?    @db.Decimal(10, 7)
  lng          Decimal?    @db.Decimal(10, 7)
  /// Verdict géorepérage calculé à l'ingestion.
  geofenceOk   Boolean?
  receivedAt   DateTime    @default(now())
  rawPayload   Json?

  employee     Employee?   @relation(fields: [employeeId], references: [id])
  device       Device?     @relation(fields: [deviceId], references: [id])
  corrections  PunchCorrection[]

  @@unique([deviceId, deviceUserId, punchedAt], name: "punch_idempotency")
  @@index([employeeId, punchedAt])
  @@index([punchedAt])
  @@map("punch")
}

enum PunchSource {
  TERMINAL
  WEB
  MOBILE
}

enum VerifyMode {
  FACE
  FINGERPRINT
  BADGE
  PIN
  GPS_ONLY
}

/// Correction manuelle : nouvelle ligne liée à l'original, avec auteur.
/// C'est ce qui rend la piste d'audit défendable en cas de litige paie.
model PunchCorrection {
  id               String   @id @default(cuid())
  punchId          String
  correctedAt      DateTime
  correctedField   String   @db.VarChar(40)
  oldValue         String?  @db.VarChar(190)
  newValue         String   @db.VarChar(190)
  reason           String   @db.VarChar(255)
  correctedById    String
  anomalyId        String?
  createdAt        DateTime @default(now())

  punch            Punch    @relation(fields: [punchId], references: [id])
  correctedBy      User     @relation(fields: [correctedById], references: [id])
  anomaly          Anomaly? @relation(fields: [anomalyId], references: [id])

  @@index([punchId])
  @@map("punch_correction")
}

// ═══════════════════════════════ PLANNING ═══════════════════════════════════

/// Gabarit de poste : fixe, variable, nuit, garde.
/// Porte crossesMidnight, les tolérances et les règles de pause (§07).
model ShiftTemplate {
  id               String  @id @default(cuid())
  code             String  @unique @db.VarChar(30)
  nameFr           String  @db.VarChar(120)
  nameAr           String? @db.VarChar(120)
  startTime        String  @db.VarChar(5)   // "HH:mm"
  endTime          String  @db.VarChar(5)   // "HH:mm" — peut être < startTime
  crossesMidnight  Boolean @default(false)
  graceLateMin     Int     @default(0)
  graceEarlyLeaveMin Int   @default(0)
  breakMin         Int     @default(0)
  breakDeducted    Boolean @default(true)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cycleSteps      CycleStep[]
  scheduleEntries ScheduleEntry[]

  @@map("shift_template")
}

/// Cycle de roulement (ex. 3×8) : une séquence répétée d'étapes.
model Cycle {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(30)
  nameFr    String   @db.VarChar(120)
  nameAr    String?  @db.VarChar(120)
  lengthDays Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps CycleStep[]

  @@map("cycle")
}

/// Jour n du cycle → gabarit (ou repos quand shiftTemplateId est nul).
model CycleStep {
  id              String         @id @default(cuid())
  cycleId         String
  dayIndex        Int            // 0 .. lengthDays-1
  shiftTemplateId String?

  cycle         Cycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])

  @@unique([cycleId, dayIndex])
  @@map("cycle_step")
}

/// Affectation planifiée d'un agent à un jour ouvré donné.
/// Quand aucune entrée explicite n'existe, le moteur l'étend depuis le cycle.
model ScheduleEntry {
  id              String   @id @default(cuid())
  employeeId      String
  siteId          String?
  serviceId       String?
  shiftTemplateId String?
  workDate        DateTime @db.Date
  /// Origine : EXPLICIT (saisie), CYCLE (expansion), IMPORT.
  origin          ScheduleOrigin @default(EXPLICIT)
  cycleId         String?
  isRestDay       Boolean  @default(false)
  locked          Boolean  @default(false) // période clôturée (clôture mensuelle)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee      Employee       @relation(fields: [employeeId], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  shiftTemplate ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])

  @@unique([employeeId, workDate])
  @@index([serviceId, workDate])
  @@map("schedule_entry")
}

enum ScheduleOrigin {
  EXPLICIT
  CYCLE
  IMPORT
}

// ═══════════════════════════════ ABSENCES ═══════════════════════════════════

model AbsenceType {
  id           String  @id @default(cuid())
  code         String  @unique @db.VarChar(30)  // CONGE_ANNUEL, MALADIE, …
  nameFr       String  @db.VarChar(120)
  nameAr       String? @db.VarChar(120)
  paid         Boolean @default(true)
  countsAgainstBalance Boolean @default(true)
  requiresJustification Boolean @default(false)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests AbsenceRequest[]
  balances LeaveBalance[]

  @@map("absence_type")
}

/// Demande d'absence : workflow demande → décision (approbation + motif).
model AbsenceRequest {
  id           String          @id @default(cuid())
  employeeId   String
  absenceTypeId String
  startDate    DateTime        @db.Date
  endDate      DateTime        @db.Date
  halfDayStart Boolean         @default(false)
  halfDayEnd   Boolean         @default(false)
  reason       String?         @db.VarChar(500)
  status       AbsenceStatus   @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionMotif String?        @db.VarChar(500)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employee     Employee        @relation(fields: [employeeId], references: [id])
  absenceType  AbsenceType     @relation(fields: [absenceTypeId], references: [id])
  decidedBy    User?           @relation(fields: [decidedById], references: [id])
  days         AbsenceDay[]

  @@index([employeeId, status])
  @@map("absence_request")
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Forme éclatée par jour d'une demande approuvée — c'est contre cette
/// table que le moteur de règles joint (§07).
model AbsenceDay {
  id               String         @id @default(cuid())
  absenceRequestId String
  employeeId       String
  day              DateTime       @db.Date
  fraction         Decimal        @default(1.0) @db.Decimal(3, 2) // 1.0 ou 0.5

  absenceRequest AbsenceRequest @relation(fields: [absenceRequestId], references: [id], onDelete: Cascade)
  employee       Employee       @relation(fields: [employeeId], references: [id])
  dayResult      DayResult?

  @@unique([employeeId, day, absenceRequestId])
  @@index([employeeId, day])
  @@map("absence_day")
}

/// Solde de congés par agent, type et année.
model LeaveBalance {
  id            String      @id @default(cuid())
  employeeId    String
  absenceTypeId String
  year          Int
  entitledDays  Decimal     @db.Decimal(5, 1)
  usedDays      Decimal     @default(0) @db.Decimal(5, 1)
  updatedAt     DateTime    @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  absenceType AbsenceType @relation(fields: [absenceTypeId], references: [id])

  @@unique([employeeId, absenceTypeId, year])
  @@map("leave_balance")
}

// ═══════════════════════════════ CALCULÉ ════════════════════════════════════

/// Une ligne par agent par jour ouvré. La table qui décide si le reporting
/// mensuel prend 40 secondes ou 40 minutes (§07 — WHY DAY_RESULT EXISTS).
model DayResult {
  id               String   @id @default(cuid())
  employeeId       String
  workDate         DateTime @db.Date
  theoreticalMin   Int?
  workedMin        Int?
  lateMin          Int      @default(0)
  earlyLeaveMin    Int      @default(0)
  overtimeMin      Int      @default(0)
  breakDeductedMin Int      @default(0)
  /// Absence approuvée recouvrant le jour (overlay étape 6 du pipeline).
  absenceDayId     String?  @unique
  /// Drapeaux d'anomalie calculés (liste de codes, ex. MISSING_OUT).
  anomalyFlags     Json?
  /// Empreinte des entrées ayant produit ce résultat — recalcul incrémental.
  inputHash        String?  @db.VarChar(64)
  computedAt       DateTime @default(now())
  /// Période verrouillée par la clôture mensuelle — recalcul refusé (§08).
  locked           Boolean  @default(false)

  employee   Employee    @relation(fields: [employeeId], references: [id])
  absenceDay AbsenceDay? @relation(fields: [absenceDayId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("day_result")
}

/// Heures supplémentaires détectées par le moteur, validées par le Gestionnaire.
model OvertimeRequest {
  id          String         @id @default(cuid())
  employeeId  String
  workDate    DateTime       @db.Date
  minutes     Int
  status      OvertimeStatus @default(PENDING)
  validatedById String?
  validatedAt DateTime?
  motif       String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  employee    Employee       @relation(fields: [employeeId], references: [id])
  validatedBy User?          @relation(fields: [validatedById], references: [id])

  @@index([employeeId, workDate])
  @@map("overtime_request")
}

enum OvertimeStatus {
  PENDING
  VALIDATED
  REJECTED
}

/// File d'anomalies résolue par le superviseur, avec traçabilité complète.
/// Un pointage non apparié devient une anomalie, jamais une heure inventée.
model Anomaly {
  id          String        @id @default(cuid())
  employeeId  String
  workDate    DateTime      @db.Date
  code        AnomalyCode
  detail      Json?
  status      AnomalyStatus @default(OPEN)
  resolvedById String?
  resolvedAt  DateTime?
  resolution  String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())

  employee    Employee        @relation(fields: [employeeId], references: [id])
  resolvedBy  User?           @relation(fields: [resolvedById], references: [id])
  corrections PunchCorrection[]

  @@index([status, workDate])
  @@index([employeeId, workDate])
  @@map("anomaly")
}

enum AnomalyCode {
  MISSING_OUT
  MISSING_IN
  NO_PLAN
  OFF_SITE
  IMPOSSIBLE_TRANSITION
  OVERTIME_PENDING
  GEOFENCE_VIOLATION
}

enum AnomalyStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ════════════════════════════════ ACCÈS ═════════════════════════════════════

/// Compte applicatif. Quatre profils CCTP : Administrateur, DRH,
/// Gestionnaire, Superviseur. argon2id, complexité, renouvellement, verrouillage.
model User {
  id             String    @id @default(cuid())
  username       String    @unique @db.VarChar(60)
  email          String?   @unique @db.VarChar(190)
  passwordHash   String    @db.VarChar(255)
  roleId         String
  employeeId     String?   @unique
  totpSecret     String?   @db.VarChar(64) // admins uniquement (P1)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  passwordChangedAt DateTime @default(now())
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role              Role              @relation(fields: [roleId], references: [id])
  employee          Employee?         @relation(fields: [employeeId], references: [id])
  scopes            UserScope[]
  corrections       PunchCorrection[]
  decidedAbsences   AbsenceRequest[]
  validatedOvertime OvertimeRequest[]
  resolvedAnomalies Anomaly[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("user")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(30) // ADMIN, DRH, GESTIONNAIRE, SUPERVISEUR
  nameFr      String   @db.VarChar(120)
  description String?  @db.VarChar(255)

  users       User[]
  permissions Permission[]

  @@map("role")
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  /// Ex. "planning:write", "absence:decide", "report:export", "device:manage".
  key    String @db.VarChar(60)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
  @@map("permission")
}

/// Portée RBAC : un Gestionnaire est limité à des services,
/// un Superviseur à une équipe (§07).
model UserScope {
  id        String     @id @default(cuid())
  userId    String
  scopeType ScopeType
  serviceId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@map("user_scope")
}

enum ScopeType {
  ALL
  SERVICES
  TEAM
}

// ═══════════════════════════════ PLATEFORME ═════════════════════════════════

/// Journal d'audit écrit par un middleware Prisma — aucune route ne peut
/// l'oublier (§07). Exigé par la loi organique 63/2004.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(60)  // ex. "absence.decide", "period.unlock"
  entity     String   @db.VarChar(60)
  entityId   String?  @db.VarChar(40)
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(40) // MISSED_PUNCH, PENDING_APPROVAL, PLANNING_CHANGE, DEVICE_OFFLINE
  title     String   @db.VarChar(190)
  body      String?  @db.VarChar(1000)
  linkUrl   String?  @db.VarChar(255)
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notification")
}

model Setting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("setting")
}

/// File de jobs adossée à la base — délibérément pas Redis (§03).
/// Rapports mensuels, exports, pulls de réconciliation.
model Job {
  id          String    @id @default(cuid())
  kind        String    @db.VarChar(40) // REPORT_MONTHLY, RECONCILE_PULL, EXPORT, …
  payload     Json?
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  resultRef   String?   @db.VarChar(255) // chemin du fichier d'export produit
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
  @@map("job")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Abonnements webhook : punch.created, absence.approved, device.offline (§09).
model WebhookSubscription {
  id         String   @id @default(cuid())
  url        String   @db.VarChar(500)
  events     Json     // ["punch.created", …]
  secret     String   @db.VarChar(80)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("webhook_subscription")
}
